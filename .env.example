# Copy file này thành .env rồi điền thông tin MySQL trên máy mình.
# KHÔNG commit file .env lên GitHub.

APP_ENV=dev

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ban_do_ky_uc
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai
ACCESS_TOKEN_MINUTES=1440

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://127.0.0.1:8000/api/auth/facebook/callback
FACEBOOK_HTTP_TIMEOUT_SECONDS=5
MEDIA_SECRET=doi-thanh-chuoi-ngau-nhien-khac

# Địa chỉ trang web (link trong email đặt lại mật khẩu)
APP_BASE_URL=http://127.0.0.1:8000

# Google OAuth (US-ACC-003): Google Cloud Console → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback

# Email đặt lại mật khẩu (US-ACC-005). Để trống SMTP_HOST khi dev: trang quên mật khẩu hiện link thử.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=<gmail>, SMTP_PASSWORD=<App Password 16 ký tự>
# Mailtrap (kiểm thử): lấy host/port/user/pass trong Sandbox → SMTP Settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=false

# Gemini AI gợi ý hashtag (FR-3.6, tùy chọn)
GEMINI_API_KEY=
