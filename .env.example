# Copy file này thành .env rồi điền thông tin MySQL trên máy mình.
# KHÔNG commit file .env lên GitHub.

APP_ENV=dev

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ban_do_ky_uc

# Facebook OAuth (US-ACC-004)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://127.0.0.1:8000/api/auth/facebook/callback
FACEBOOK_HTTP_TIMEOUT_SECONDS=5

# Shared JWT signing key (required to issue application sessions)
JWT_SECRET_KEY=replace-with-a-long-random-secret
